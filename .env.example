# Newsletter (MailerLite). GROUP_ID é opcional.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Formulário de parceiros: URL de webhook (Google Apps Script de planilha, Zapier, Make...)
PARTNERS_WEBHOOK_URL=

# Neon: banco (Postgres) e cadastro de tripulantes (Neon Auth)
DATABASE_URL=
NEON_AUTH_BASE_URL=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=

# Sistemas de ficha (src/config/fichas.ts): URL do deploy de cada app, sem barra no fim.
# Em dev, sem valor, usa http://localhost:3001 pro Shadowrun.
FICHAS_SHADOWRUN_URL=
