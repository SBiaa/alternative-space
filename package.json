{
  "name": "alternative",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:diario": "node --env-file-if-exists=.env.local scripts/seed-diario.mjs",
    "seed:riff": "node --env-file-if-exists=.env.local --import tsx scripts/seed-riff.ts",
    "fichas:sr5:data": "tsx scripts/fichas-sr5/index.ts",
    "seed:entrega": "node --env-file-if-exists=.env.local --import tsx scripts/seed-entrega.ts",
    "seed:taverna": "node --env-file-if-exists=.env.local --import tsx scripts/seed-taverna.ts",
    "seed:lan": "node --env-file-if-exists=.env.local --import tsx scripts/seed-lan.ts",
    "mapa:entrega": "tsx scripts/bairro-entrega.ts",
    "seed:role": "node --env-file-if-exists=.env.local --import tsx scripts/seed-role.ts"
  },
  "dependencies": {
    "@neon/auth": "^0.8.2",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "gray-matter": "^4.0.3",
    "next": "16.4.3",
    "next-mdx-remote": "^6.0.0",
    "phaser": "^3.90.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "fast-xml-parser": "^5.12.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
